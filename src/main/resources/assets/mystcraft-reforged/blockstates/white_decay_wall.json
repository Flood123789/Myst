{
  "multipart": [
    { "when": { "up": "true" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_post" } },
    { "when": { "north": "low" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side" } },
    { "when": { "east": "low" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side", "y": 90 } },
    { "when": { "south": "low" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side", "y": 180 } },
    { "when": { "west": "low" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side", "y": 270 } },
    { "when": { "north": "tall" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side_tall" } },
    { "when": { "east": "tall" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side_tall", "y": 90 } },
    { "when": { "south": "tall" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side_tall", "y": 180 } },
    { "when": { "west": "tall" }, "apply": { "model": "mystcraft-reforged:block/white_decay_wall_side_tall", "y": 270 } }
  ]
}
