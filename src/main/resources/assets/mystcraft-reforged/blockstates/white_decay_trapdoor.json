    { "when": { "facing": "south", "open": "true" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_open", "y": 180 } },

    { "when": { "facing": "west", "half": "bottom", "open": "false" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_bottom" } },
    { "when": { "facing": "west", "half": "top", "open": "false" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_top" } },
    { "when": { "facing": "west", "open": "true" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_open", "y": 270 } }
