    { "when": { "facing": "east", "half": "bottom", "open": "false" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_bottom" } },
    { "when": { "facing": "east", "half": "top", "open": "false" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_top" } },
    { "when": { "facing": "east", "open": "true" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_open", "y": 90 } },

    { "when": { "facing": "south", "half": "bottom", "open": "false" }, "apply": { "model": "mystcraft-reforged:block/white_decay_trapdoor_bottom" } },
